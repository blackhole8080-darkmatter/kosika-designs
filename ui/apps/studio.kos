// Designs Studio: an agent window that Kosika Designs designed, and that runs.
//
// Its window is a design (designs_ui.kos). Its parts are bound to the
// workflows below: what you type goes to studio_ask, which asks the
// Designs front door to draw it; the answer comes back into the chat with
// the drawing inside it, and the plan and the numbers on the right are
// filled from the same answer. Nothing on the page is hand-written.
//
//   .\ui\apps\studio.ps1                       (draws the window, serves it, opens it)
//
// or by hand:
//
//   kosika-native run ui/apps/studio.kos --workflow studio_window --input win.json --json   (write .page to studio.html)
//   kosika-native serve ui/apps/studio.kos --page studio.html --model openai/gpt-oss-120b
//       --model-url https://api.groq.com/openai/v1 --model-protocol openai --max-output-tokens 8000
//
// where win.json holds {"w": {"theme": "dark"}}.

import "std/designs.kos"
import "std/designs_ui.kos"

record StSay { text: Text }
record StWin { theme: Text }
record StReply { text: Text page: Text steps: UiItem[] stats: UiItem[] }

fn st_item(title: Text, text: Text, meta: Text, icon: Text) -> UiItem { return {title: title, text: text, meta: meta, icon: icon} }

fn st_cut(text: Text, most: Number) -> Text {
  if text.length() <= most { return text }
  return text.slice(0, most).trim() + "…"
}

fn st_kind_name(kind: Text) -> Text {
  if kind == "ui" { return "a screen" }
  if kind == "canvas" { return "a science canvas" }
  if kind == "worked" { return "worked mathematics" }
  return "a " + kind
}

fn st_reply(say: StSay, d: DzResult) -> StReply {
  let drew = d.problems.is_empty()
  let fixes = for f in d.fixed.take(3) { st_item("Fixed", f, "done", "") }
  let steps = [st_item("Read your ask", say.text, "done", ""), st_item("Chose " + st_kind_name(d.kind), st_cut(d.why, 90), "done", "")].concat(fixes).concat([st_item(if drew { "Checked and drew it" } else { "Stopped before drawing" }, if drew { d.title } else { d.problems[0] }, if drew { "done" } else { "failed" }, "")])
  let stats = [st_item(d.kind, "kind", "", ""), st_item(f"{d.fixed.length()}", "things fixed", "", ""), st_item(f"{d.problems.length()}", "problems", "", "")]
  let words = if drew { f"Here is {d.title}, drawn as {st_kind_name(d.kind)}. Ask again to change it, or for something new." } else { "I could not draw that: " + d.problems.join("; ") }
  return {text: words, page: if drew { d.page } else { "" }, steps: steps, stats: stats}
}

// What you type: drawn by the Designs front door.
workflow studio_ask(say: StSay) -> StReply {
  budget 12 model calls, 900 seconds
  drawn = call design({text: say.text, palette: "", place: "agent", kind: ""})
  out   = st_reply(say, drawn)
}

fn st_block(kind: Text, title: Text, text: Text, meta: Text, action: Text, items: UiItem[]) -> UiBlock {
  return {kind: kind, title: title, text: text, meta: meta, action: action, items: items}
}

fn st_spec(theme: Text) -> UiSpec {
  return {target: "agent", title: "Designs Studio", brand: "Kosika Designs", accent: "orange", theme: if theme == "light" { "light" } else { "dark" }, look: {colours: [], shape: "soft", art: "aurora", font: "grotesk"}, screens: [{name: "Studio", blocks: [
    st_block("sidebar", "Kosika Designs", "Free models only. Every drawing checked.", "", "New design", [st_item("Studio", "", "", "spark"), st_item("Screens", "", "", "grid"), st_item("Diagrams", "", "", "layers"), st_item("Science", "", "", "leaf"), st_item("Palettes", "", "", "image")]),
    st_block("appbar", "Design anything", "A website, a phone app, an agent window, a diagram, or how something works", "Ready", "", []),
    st_block("chat", "", "", "", "", [st_item("Kosika Designs", "Tell me what to design. Try: a landing page for a quiet coffee shop, a phone app for learning Japanese, or how does the heart pump blood.", "agent", "")]),
    st_block("composer", "", "Describe what to design…", "", "", []),
    st_block("activity", "This design", "", "", "", [st_item("Read your ask", "", "next", ""), st_item("Choose how to draw it", "", "next", ""), st_item("Check and draw", "", "next", "")]),
    st_block("stats", "Numbers", "", "", "", [st_item("–", "kind", "", ""), st_item("0", "things fixed", "", "")])
  ]}]}
}

fn st_binds() -> UiBind[] {
  return [
    {block: "composer", workflow: "studio_ask", input: "say", field: "", every: 0},
    {block: "activity", workflow: "", input: "", field: "steps", every: 0},
    {block: "stats", workflow: "", input: "", field: "stats", every: 0}
  ]
}

// The window itself, drawn by Designs with its runtime.
workflow studio_window(w: StWin) -> UiResult {
  out = call ui_app({ask: {text: "an agent window for Kosika Designs", target: "agent", theme: w.theme, accent: "orange"}, spec: st_spec(w.theme), binds: st_binds()})
}

test "the studio's window is bound to its own workflows" {
  expect (for b in st_binds() { b.block }) == ["composer", "activity", "stats"]
  expect st_spec("").theme == "dark"
}

test "a reply carries the plan and the numbers the window shows" {
  d: DzResult = {kind: "ui", why: "asks for a screen", title: "Bakery", page: "<p>", svg: "", embed: "", problems: [], fixed: ["gave the page a footer"]}
  r = st_reply({text: "a bakery site"}, d)
  expect r.steps.length() == 4
  expect r.stats[1].title == "1"
  expect r.page == "<p>"
}
